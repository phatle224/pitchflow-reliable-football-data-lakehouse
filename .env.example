# Docker Compose runtime defaults. Copy to .env and replace for non-local use.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
PITCHFLOW_MINIO_BUCKET=pitchflow
PITCHFLOW_MINIO_ENDPOINT=http://minio:9000
# Active pinned source profile. Premier League 2015/16 contains 380 matches.
PITCHFLOW_SOURCE_CONFIG=config/statsbomb_source.json
# Keep raw Spark DataFrame creation bounded for full-season snapshots.
PITCHFLOW_INGEST_CHUNK_SIZE=25

POSTGRES_USER=pitchflow
POSTGRES_PASSWORD=pitchflow
PITCHFLOW_POSTGRES_HOST=postgres
PITCHFLOW_POSTGRES_PORT=5432
PITCHFLOW_POSTGRES_DB=pitchflow
PITCHFLOW_POSTGRES_USER=pitchflow
PITCHFLOW_POSTGRES_PASSWORD=pitchflow

# V2 reliability policy. Values are percentages; a pass rate below the failure
# threshold fails the Spark task, while a rate below the warning threshold alerts.
PITCHFLOW_DQ_WARNING_PASS_RATE=95
PITCHFLOW_DQ_FAILURE_PASS_RATE=80
PITCHFLOW_DQ_QUARANTINE_RATE_WARNING=20
PITCHFLOW_DQ_QUARANTINE_RATE_FAILURE=40
PITCHFLOW_DQ_LATE_EVENT_WARNING=10
PITCHFLOW_DQ_LATE_EVENT_FAILURE=25
PITCHFLOW_ALERT_WEBHOOK_URL=
PITCHFLOW_AIRFLOW_RETRIES=2
PITCHFLOW_AIRFLOW_RETRY_DELAY_MINUTES=5
PITCHFLOW_AIRFLOW_MAX_RETRY_DELAY_MINUTES=30

# V2 watermark-based incremental processing. Set to 0 to disable (use run_id only).
PITCHFLOW_WATERMARK_LOOKBACK_HOURS=24

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=airflow@example.local
